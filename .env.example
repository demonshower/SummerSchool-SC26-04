# Database
DATABASE_URL="postgresql://tripplanner:tripplanner_dev@localhost:5432/trip_planner?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# App
NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://your-frontend-domain.com

# LLM (OpenAI-compatible, e.g. ECNU / DashScope)
LLM_PROVIDER=ecnu
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
LLM_API_KEY=
LLM_MODEL=ecnu-plus
LLM_TIMEOUT_MS=60000

# Amap Web Service
MAP_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_KEY=

# Weather (amap | qweather)
WEATHER_PROVIDER=amap
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# Web research: Bocha
SEARCH_PROVIDER=bocha
BOCHA_API_BASE_URL=https://api.bochaai.com/v1
BOCHA_API_KEY=
ENABLE_WEB_RESEARCH=true

# Feature flags
ENABLE_LLM=true
ENABLE_AMAP=true
ENABLE_LIVE_WEATHER=true
